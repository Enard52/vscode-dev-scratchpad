{
  "name": "dev-scratchpad",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.1",
  "publisher": "Enard52",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Productivity",
    "Other"
  ],
  "keywords": [
    "scratchpad",
    "notes",
    "developer",
    "productivity",
    "snippet",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Enard52/vscode-dev-scratchpad"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:devScratchpad.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devScratchpad.open",
        "title": "%command.open%",
        "category": "Scratchpad"
      },
      {
        "command": "devScratchpad.clear",
        "title": "%command.clear%",
        "category": "Scratchpad"
      }
    ],
    "keybindings": [
      {
        "command": "devScratchpad.open",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ]
  }
}
